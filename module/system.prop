# Game Space Unleashed by MsysteM — System Properties
# These are set EARLY by Magisk (before zygote/apps start)
# This ensures GameAssist/GameSpace read them before caching in <clinit>()
#
# Convention: com.zte.feature.Feature.getBoolean("ZTE_FEATURE_X")
#   reads from SystemProperties.getBoolean("ro.vendor.feature.zte_feature_x")
#   (lowercase, with ro.vendor.feature. prefix)

# ── Core device identity ──
ro.vendor.feature.zte_feature_red_magic=true
ro.vendor.feature.zte_feature_red_magic_phone=true

# ── Game Space / GameAssist master switches ──
ro.vendor.feature.zte_feature_magic_game_assist=true
ro.vendor.feature.zte_feature_gamespace_config=true
ro.vendor.feature.zte_feature_base_game_plugin_game=true

# ── Super Resolution & GFRC (R3 chip) ──
ro.vendor.feature.zte_feature_magic_super_resolution=true
ro.vendor.feature.zte_feature_superior_quality_game=true
ro.vendor.feature.zte_feature_gfrc=true
ro.vendor.feature.zte_feature_magic_resolutions=true
ro.vendor.feature.zte_feature_magic_resolutions_settings=true

# ── Plugin features ──
