# Game Space Unleashed by MsysteM — System Properties
# v2.3.0: Only set properties the VENDOR doesn't already set.
# The diagnostic proved the vendor already sets all game feature props to true.
# Re-setting them via system.prop caused the sidebutton launcher to break.
#
# This file ONLY contains properties that are either:
# - NOT set by vendor at all
# - Set to false by vendor but we want true

# ── MFV Window Reply (not in vendor's default prop list) ──
ro.vendor.feature.mfv_feature_windowreply=true

# ── Game Magic Voice (vendor sets false, we force true) ──
ro.vendor.feature.zte_feature_game_magic_voice=true

# ── GFRC persist properties (non-ro, but set early) ──
persist.magic.super.resolution=1
persist.vendor.gfrc.enable=1
