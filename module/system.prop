# Game Space Unleashed v3.0.0 by MsysteM

# ── GFRC — ALL games get Super Resolution + Frame Interpolation ──
vendor.gpp.allgame.enable=1
persist.vendor.gfrc.enable=1
persist.magic.super.resolution=1

# ── Feature gates the vendor leaves EMPTY or sets wrong ──
ro.vendor.feature.zte_feature_magic_super_resolution=true
ro.vendor.feature.zte_feature_shoulder_key_launch_gamespace=true
ro.vendor.feature.zte_feature_game_magic_voice=true
ro.vendor.feature.mfv_feature_windowreply=true

# ── Utils.d() plugin gate overrides — unlock ALL plugins ──
ro.vendor.feature.zte_feature_gameassist_voice_controller=true
ro.vendor.feature.zte_feature_game_ai_tips=true
ro.vendor.feature.zte_feature_ai_game_prediction=true
ro.vendor.feature.zte_feature_game_sound_probe=true
ro.vendor.feature.zte_feature_low_sugar=true
ro.vendor.feature.zte_feature_game_ai_jarvis=true
ro.vendor.feature.zte_feature_gameassist_plugin_data_panel=true
ro.vendor.feature.zte_feature_gameassist_plugin_redmagic_broadcast=true
ro.vendor.feature.zte_feature_gameassist_plugin_redmagic_elvesaid=true
ro.vendor.feature.zte_feature_gameassist_plugin_chat_assist=true
ro.vendor.feature.zte_feature_gameassist_plugin_biablo=true
ro.vendor.feature.zte_feature_gameassist_plugin_fixedlook=true
ro.vendor.feature.zte_feature_gameassist_plugin_ai_trigger=true
ro.vendor.feature.zte_feature_gameassist_plugin_card_assist=true
ro.vendor.feature.zte_feature_gameassist_audio_equalizer=true
ro.vendor.feature.zte_feature_ai_speaker=true
ro.vendor.feature.zte_feature_game_plugin_counter=true
